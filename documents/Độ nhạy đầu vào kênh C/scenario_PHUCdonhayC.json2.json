{
  "name": "Kịch bản đo độ nhạy đầu vào Kênh C - CNT90 (theo QTKĐ 2.461:2018, mục 5.3.4, Bảng A4)",
  "description": "Dò công suất tối thiểu (độ nhạy) trên Input C của CNT90 tại 11 điểm tần số chuẩn quy trình: 400 MHz, 1 GHz, 2 GHz, 5 GHz, 10 GHz, 13 GHz, 16 GHz, 18 GHz, 19,9 GHz, 20 GHz, 22 GHz. Giữ nguyên cấu trúc thuật toán dò công suất tăng dần của kịch bản gốc, chỉ thay danh sách tần số quét bằng đúng các điểm quy định thay vì công thức nhân đôi octave (250MHz*2^n, chỉ tới 8GHz như trước). Ngưỡng đạt: ≤ -27 dBm (400MHz-16GHz, 20-22GHz), ≤ -29 dBm (18GHz, 19,9GHz).",
  "nodes": [
    {
      "action": "raw_scpi",
      "devices": [
        "CNT90"
      ],
      "params": {
        "__template__": "*RST",
        "__is_query__": false,
        "__cmd_original__": "*RST",
        "__cmd_desc__": "Reset thiết bị về cài đặt mặc định nhà máy"
      },
      "note": "",
      "enabled": true,
      "type": "step"
    },
